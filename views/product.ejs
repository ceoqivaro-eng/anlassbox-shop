<%- include('partials/head') %>

<div class="container">
  <nav class="breadcrumb" aria-label="Pfad">
    <a href="/">Startseite</a>
    <span aria-hidden="true">/</span>
    <a href="/#boxen">Boxen</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page"><%= product.name %></span>
  </nav>
</div>

<section class="product-detail container">
  <div class="detail-gallery">
    <div class="gallery-main">
      <% if (product.badge) { %><span class="card-badge"><%= product.badge %></span><% } %>
      <img id="gallery-main-img" src="<%= product.images[0] || '/img/boxes/platzhalter.svg' %>" alt="<%= product.name %>">
    </div>
    <% if (product.images.length > 1) { %>
      <div class="gallery-thumbs" role="group" aria-label="Weitere Bilder">
        <% product.images.forEach((image, i) => { %>
          <button type="button" class="gallery-thumb <%= i === 0 ? 'is-active' : '' %>" data-gallery-src="<%= image %>">
            <img src="<%= image %>" alt="Bild <%= i + 1 %> von <%= product.name %>">
          </button>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div class="detail-info">
    <% if (product.category_name) { %><span class="detail-category"><%= product.category_name %></span><% } %>
    <h1><%= product.name %></h1>
    <p class="detail-subtitle"><%= product.subtitle %></p>

    <div class="detail-price-row">
      <span class="detail-price"><%= formatEuro(product.price_cents) %></span>
      <span class="detail-shipping">
        inkl. MwSt.
        <% if (settings.free_shipping_from_cents > 0 && product.price_cents >= settings.free_shipping_from_cents) { %>
          &middot; kostenloser Versand
        <% } else { %>
          &middot; zzgl. Versand
        <% } %>
      </span>
    </div>

    <p class="detail-description"><%= product.description %></p>

    <div class="buy-row">
      <div class="qty-stepper" data-qty>
        <button type="button" data-qty-minus aria-label="Menge verringern">&minus;</button>
        <input type="number" value="1" min="1" max="99" inputmode="numeric" aria-label="Menge">
        <button type="button" data-qty-plus aria-label="Menge erhöhen">+</button>
      </div>
      <button type="button" class="btn btn-primary btn-add" data-add-to-cart data-slug="<%= product.slug %>">
        In den Warenkorb
      </button>
    </div>

    <ul class="detail-trust">
      <li>Handverpackt &amp; versandfertig in 48&nbsp;Stunden</li>
      <li>14 Tage Widerrufsrecht</li>
      <li>Sichere Zahlung über Stripe</li>
    </ul>
  </div>
</section>

<section class="section contents-section">
  <div class="container">
    <div class="section-head">
      <h2>Das ist drin</h2>
      <p><%= product.items.length %> aufeinander abgestimmte Teile &ndash; von Hand ausgewählt.</p>
    </div>
    <ol class="contents-list">
      <% product.items.forEach((item) => { %>
        <li>
          <strong><%= item.name %></strong>
          <% if (item.note) { %><span><%= item.note %></span><% } %>
        </li>
      <% }) %>
    </ol>
  </div>
</section>

<% if (related.length > 0) { %>
  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <h2>Passt auch zu einem Anlass in deinem Leben?</h2>
      </div>
      <div class="product-grid">
        <% related.forEach((product) => { %>
          <%- include('partials/product-card', { product }) %>
        <% }) %>
      </div>
    </div>
  </section>
<% } %>

<%- include('partials/footer') %>
