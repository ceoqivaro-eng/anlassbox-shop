<%- include('partials/head') %>

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Handverpackte Geschenkboxen</p>
      <h1>Eine Box für jeden<br><em>Anlass</em><span class="accent-dot">.</span></h1>
      <p class="lead">
        Erste Wohnung, bestandener Führerschein, Babyglück oder Neuanfang:
        Wir packen die großen Momente des Lebens in eine Box &ndash; durchdacht
        bestückt, liebevoll verpackt, fertig zum Verschenken.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#boxen">Boxen entdecken</a>
        <a class="btn btn-ghost" href="#so-gehts">So funktioniert&rsquo;s</a>
      </div>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <% products.slice(0, 3).forEach((product, i) => { %>
        <div class="hero-card hero-card-<%= i + 1 %>">
          <img src="<%= product.images[0] || '/img/boxes/platzhalter.svg' %>" alt="">
          <span><%= product.name %></span>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<div class="trust-bar">
  <div class="container trust-inner">
    <span>Handverpackt in Deutschland</span>
    <span>Versandfertig in 48&nbsp;Stunden</span>
    <% if (settings.free_shipping_from_cents > 0) { %>
      <span>Kostenloser Versand ab <%= formatEuro(settings.free_shipping_from_cents) %></span>
    <% } else { %>
      <span>Sichere Zahlung über Stripe</span>
    <% } %>
  </div>
</div>

<section class="section" id="boxen">
  <div class="container">
    <div class="section-head">
      <h2>Unsere Boxen</h2>
      <p>Jede Box ist ein komplettes Geschenk &ndash; du musst nur noch schenken.</p>
    </div>

    <% if (categories.length > 1) { %>
      <nav class="filter-pills" aria-label="Nach Kategorie filtern">
        <a class="pill <%= !activeCategory ? 'is-active' : '' %>" href="/#boxen">Alle</a>
        <% categories.forEach((category) => { %>
          <a class="pill <%= activeCategory && activeCategory.id === category.id ? 'is-active' : '' %>"
             href="/?kategorie=<%= category.slug %>#boxen"><%= category.name %></a>
        <% }) %>
      </nav>
    <% } %>

    <% if (products.length === 0) { %>
      <p class="empty-note">In dieser Kategorie gibt es noch keine Boxen &ndash; schau bald wieder vorbei!</p>
    <% } else { %>
      <div class="product-grid">
        <% products.forEach((product) => { %>
          <%- include('partials/product-card', { product }) %>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<section class="section section-alt" id="so-gehts">
  <div class="container">
    <div class="section-head">
      <h2>So funktioniert&rsquo;s</h2>
      <p>Vom Anlass zum fertigen Geschenk in drei Schritten.</p>
    </div>
    <div class="steps">
      <div class="step">
        <span class="step-number">1</span>
        <h3>Box auswählen</h3>
        <p>Such die Box aus, die zum Anlass passt &ndash; jede ist mit bis zu zehn aufeinander abgestimmten Teilen bestückt.</p>
      </div>
      <div class="step">
        <span class="step-number">2</span>
        <h3>Wir packen mit Liebe</h3>
        <p>Jede Box wird von Hand gepackt, hübsch verpackt und innerhalb von 48 Stunden auf die Reise geschickt.</p>
      </div>
      <div class="step">
        <span class="step-number">3</span>
        <h3>Freude verschenken</h3>
        <p>Direkt zu dir oder als Überraschung an die beschenkte Person &ndash; auspacken, staunen, freuen.</p>
      </div>
    </div>
  </div>
</section>

<section class="cta-band">
  <div class="container cta-inner">
    <h2>Dein Anlass ist nicht dabei?</h2>
    <p>Unser Sortiment wächst ständig &ndash; bald auch mit Boxen für Feiertage, Hobbys und Events.</p>
  </div>
</section>

<%- include('partials/footer') %>
