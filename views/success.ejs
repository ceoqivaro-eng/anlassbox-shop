<%- include('partials/head') %>

<section class="section">
  <div class="container success-box" id="order-success" <% if (order) { %>data-order-complete<% } %>>
    <svg class="success-icon" viewBox="0 0 48 48" aria-hidden="true">
      <circle cx="24" cy="24" r="22" fill="none" stroke="var(--accent)" stroke-width="3"/>
      <path d="M15 24.5 21 31l12-14" fill="none" stroke="var(--accent)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <% if (order) { %>
      <h1>Danke für deine Bestellung!</h1>
      <p class="success-ref">Deine Bestellnummer: <strong><%= order.ref %></strong></p>
      <% if (demo) { %>
        <p class="success-demo">
          <strong>Demo-Modus:</strong> Die Bestellung wurde gespeichert, aber es wurde keine
          Zahlung ausgeführt. Sobald Stripe eingerichtet ist, läuft hier die echte Kasse.
        </p>
      <% } else { %>
        <p>Wir packen deine Box mit Liebe und melden uns per E-Mail, sobald sie auf dem Weg ist.</p>
      <% } %>
    <% } else { %>
      <h1>Keine Bestellung gefunden</h1>
      <p>Zu diesem Link gibt es keine Bestellung. Vielleicht ist der Link abgelaufen?</p>
    <% } %>

    <a class="btn btn-primary" href="/#boxen">Weiter stöbern</a>
  </div>
</section>

<%- include('partials/footer') %>
