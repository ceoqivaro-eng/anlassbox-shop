<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? `${title} · ${settings.shop_name}` : `${settings.shop_name} · Eine Box für jeden Anlass` %></title>
  <meta name="description" content="Liebevoll gepackte Geschenkboxen für die großen Momente: erste Wohnung, Führerschein, Baby, Reise und Neuanfang.">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23E8543F'/%3E%3Cpath d='M14.5 5h3v22h-3z' fill='%23FFF7F1'/%3E%3Cpath d='M5 14.5h22v3H5z' fill='%23FFF7F1'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/shop.css">
</head>
<body>
<a class="skip-link" href="#main">Zum Inhalt springen</a>

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="<%= settings.shop_name %> – Startseite">
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
        <rect width="32" height="32" rx="7" fill="var(--accent)"/>
        <path d="M14.5 5h3v22h-3z" fill="#FFF7F1"/>
        <path d="M5 14.5h22v3H5z" fill="#FFF7F1"/>
      </svg>
      <span class="brand-name">Anlass<em>Box</em></span>
    </a>
    <nav class="main-nav" aria-label="Hauptnavigation">
      <a href="/#boxen">Boxen</a>
      <a href="/#so-gehts">So funktioniert&rsquo;s</a>
      <% if (isAdmin) { %><a href="/admin/produkte">Admin</a><% } %>
    </nav>
    <a class="cart-link" href="/warenkorb">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 7h12l1.2 13H4.8L6 7z"/>
        <path d="M9 9V6a3 3 0 0 1 6 0v3"/>
      </svg>
      <span>Warenkorb</span>
      <span class="cart-count" data-cart-count hidden>0</span>
    </a>
  </div>
</header>

<main id="main">
