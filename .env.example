# Kopiere diese Datei zu ".env" und passe die Werte an.

# Port, auf dem der Shop läuft
PORT=3000

# Öffentliche Adresse des Shops (für Stripe-Weiterleitungen)
BASE_URL=http://localhost:3000

# Passwort für den Admin-Bereich (/admin) – UNBEDINGT ändern!
ADMIN_PASSWORD=bitte-aendern

# Zufälliger geheimer Schlüssel für Login-Sitzungen (beliebige lange Zeichenkette)
SESSION_SECRET=bitte-durch-zufallszeichen-ersetzen

# Stripe-Schlüssel (https://dashboard.stripe.com/apikeys)
# Solange STRIPE_SECRET_KEY leer ist, läuft der Checkout im DEMO-Modus (keine echte Zahlung).
STRIPE_SECRET_KEY=
# Pflicht sobald Stripe live ist: nur mit diesem Secret werden Zahlungen automatisch
# bestätigt. Ohne Secret lehnt der Webhook aus Sicherheitsgründen alles ab – du markierst
# Bestellungen dann von Hand im Admin unter „Bestellungen“.
STRIPE_WEBHOOK_SECRET=

# In Produktion (echtes HTTPS-Hosting) auf "production" setzen – aktiviert secure-Cookies.
NODE_ENV=development
